# Alembic
# Migrations ARE committed. They are the schema's version history: ignoring them
# means every environment invents its own schema and they silently diverge.
# (This file previously ignored versions/*.py, which is why the folder only ever
# contained .gitkeep and `alembic upgrade head` had nothing to apply.)
backend/alembic/versions/__pycache__/

# Environment
.env
.env.local
.env.development
.env.production
*.env.local

