# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Backend
DATABASE_URL=
DATABASE_URL_SYNC=
SECRET_KEY=
DEBUG=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend
# NOTE: NEXT_PUBLIC_* values are inlined into the browser bundle.
# Never put a secret here. The OpenAI key is server-side only (see above).
NEXT_PUBLIC_API_URL=http://localhost:8000
