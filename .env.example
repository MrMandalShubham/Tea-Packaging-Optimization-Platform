# Copy to .env and you are done:
#
#     cp .env.example .env && docker compose up -d
#
# The values below are working local defaults, not blanks to fill in. An example
# file that only works after you guess what belongs in it is a README that lies:
# `cp .env.example .env && docker compose up -d` used to fail outright with
# "Database is uninitialized and superuser password is not specified".

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Not secrets: this is a local container reachable only from this machine.
# Change them for any deployment that is not your laptop.
POSTGRES_USER=tea_user
POSTGRES_PASSWORD=tea_pass
POSTGRES_DB=tea_packaging

# ── Backend ───────────────────────────────────────────────────────────────────
# These point at localhost, for running uvicorn on the host against
# `docker compose up -d db`.
#
# Docker does NOT read them: compose derives its own URLs from POSTGRES_* above,
# because inside the compose network the database host is `db`, not `localhost`.
# That is a deployment detail rather than something you should have to know — and
# getting it wrong produces a baffling "connection refused".
DATABASE_URL=postgresql+asyncpg://tea_user:tea_pass@localhost:5432/tea_packaging
DATABASE_URL_SYNC=postgresql://tea_user:tea_pass@localhost:5432/tea_packaging

SECRET_KEY=dev-only-not-a-real-secret
DEBUG=true

# Create tables from the ORM models at startup. Development convenience only.
# Alembic owns the schema; docker compose forces this off so that a broken
# migration is loud instead of silently papered over.
AUTO_CREATE_TABLES=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── OpenAI ────────────────────────────────────────────────────────────────────
# The only real secret here, and it is OPTIONAL: the optimisation is arithmetic
# and runs without it. Left blank, the AI assistant and the written explanation
# report that they are unconfigured and everything else works normally.
#
# Server-side only. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined into the browser bundle and readable by every visitor.
# Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
